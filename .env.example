# Tovo build-time configuration. Copy to `.env` and fill in to enable.
# Everything here is OPTIONAL — with nothing set, the app ships zero tracking.
# Vite only exposes vars prefixed with VITE_ to the client.

# --- Error monitoring (Sentry) ---------------------------------------------
# Create a project at https://sentry.io (free tier) and paste its DSN.
# Leave blank to disable crash reporting entirely.
VITE_SENTRY_DSN=

# --- Privacy-friendly analytics (Plausible-compatible) ---------------------
# The domain you registered with your analytics provider, e.g. tovo.app.
# Leave blank to disable analytics entirely (no script is loaded).
VITE_PLAUSIBLE_DOMAIN=
# Optional: override the script URL for self-hosted Plausible or Umami.
# Defaults to Plausible cloud (https://plausible.io/js/script.js).
VITE_PLAUSIBLE_SRC=

# --- Account & cloud sync (Supabase) ---------------------------------------
# Create a project at https://supabase.com, run supabase/schema.sql in its SQL
# editor, then paste the Project URL and the anon/public API key here. Both must
# be set to enable accounts; leave blank to stay fully local-first.
# Also add this app's URL(s) to Supabase Auth > URL Configuration (redirects),
# e.g. https://namitzz.github.io/Tovo/ and http://localhost:5199/Tovo/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
